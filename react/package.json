{
  "name": "@dodomain/react",
  "version": "0.1.2",
  "description": "Custom domains for SaaS in React — the official DoDomain bindings: a hook (and drop-in button) around the @dodomain/connect modal widget (Cloudflare one-click, Domain Connect, guided DNS).",
  "license": "MIT",
  "author": "Devino Solutions Inc",
  "homepage": "https://dodomain.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/dodomain-sdk.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/DevinoSolutions/dodomain-sdk/issues"
  },
  "keywords": [
    "dodomain",
    "custom-domain",
    "custom-domains",
    "custom-domains-for-saas",
    "saas",
    "multi-tenant",
    "white-label",
    "bring-your-own-domain",
    "domain-connect",
    "domain-connect-protocol",
    "domainconnect",
    "dns",
    "react",
    "hooks",
    "widget"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@dodomain/connect": "^0.3.2"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "size-limit": [
    {
      "name": "react bindings (ESM, minified + brotli)",
      "path": "dist/index.js",
      "limit": "1.8 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    }
  ]
}
