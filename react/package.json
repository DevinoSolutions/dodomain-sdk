{
  "name": "@dodomain/react",
  "version": "0.1.1",
  "description": "Official React bindings for DoDomain — a hook (and drop-in button) around the @dodomain/connect modal widget.",
  "license": "MIT",
  "author": "Devino Solutions Inc",
  "homepage": "https://dodomain.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/dodomain-sdk.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/DevinoSolutions/dodomain-sdk/issues"
  },
  "keywords": [
    "dodomain",
    "custom-domain",
    "domain-connect",
    "dns",
    "react",
    "hooks",
    "widget"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@dodomain/connect": "^0.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
