{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    // Test files import "../src/index.ts" with an explicit extension
    // (matching packages/connect and packages/node's test-file convention) —
    // required whenever any import specifier in the program uses a literal
    // .ts extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tsup.config.ts"]
}
