auto-install-peers=true
strict-peer-dependencies=false

# The three SDK manifests carry REAL semver ranges for their in-repo
# dependencies (@dodomain/react -> @dodomain/connect ^0.3.0, node/connect ->
# @dodomain/core 0.0.0) rather than the workspace: protocol, because releases
# are published with `npm publish` from the package directory and npm does not
# rewrite pnpm's workspace: protocol — an unrewritten spec would ship to the
# registry verbatim. This setting is what still makes those plain ranges
# resolve to the local sibling directories during install/build/test: pnpm
# links a workspace package whenever its version satisfies the range.
# (pnpm 10 defaults this to false, so it MUST be stated.)
link-workspace-packages=true
