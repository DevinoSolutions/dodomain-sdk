{
  "name": "@dodomain/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./cloudflare": "./src/cloudflare/config.ts",
    "./records": "./src/records.ts",
    "./webhook": "./src/webhook.ts",
    "./schemas": "./src/schemas.ts",
    "./messages": "./src/messages.ts",
    "./message-types": "./src/message-types.ts",
    "./origin": "./src/origin.ts",
    "./branding": "./src/branding.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "keys": "node --experimental-strip-types tools/keygen.ts",
    "probe": "node --experimental-strip-types tools/probe.ts"
  },
  "dependencies": {
    "tldts": "^7.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
